//@version=6
// =============================================================================
// Gold Trades - Range Breakout Strategy
//
// Backtest twin of MT5/Experts/GoldTradesBreakoutEA.mq5.
//
//   ENTRY  : close breaks the ceiling of a VALIDATED consolidation range,
//            while fast MA (9) > slow MA (20), inside the session window
//   SIZING : risk % of equity against the stop, scaled by two percentile
//            extension gates - full size, half size, or no trade
//   FILL   : 50% on the breakout, the other 50% if the first bar in the
//            trade closes green
//   ADDS   : a further slice at each +1R, capped
//   EXIT   : bar closes under the fast MA (9)
//
// Run on M5 to match the indicator: the 150 MA and the "once 5min closes"
// open check both use the CHART timeframe.
//
// Read the notes at the bottom before trusting any number.
// =============================================================================
strategy(title                   = "Gold Trades - Range Breakout Strategy",
         shorttitle              = "GT Range Breakout",
         overlay                 = true,
         initial_capital         = 10000,
         default_qty_type        = strategy.percent_of_equity,
         default_qty_value       = 10,
         commission_type         = strategy.commission.percent,
         commission_value        = 0.0,
         slippage                = 0,
         pyramiding              = 10,
         calc_on_every_tick      = false,
         process_orders_on_close = false,
         max_boxes_count         = 500,
         max_labels_count        = 500)

// ── MOVING AVERAGES (the 9 / 20 filter) ──────────────────────────────────────
grpMa      = "Moving averages (the 9 / 20 filter)"
maTypeStr  = input.string("EMA", "MA type", options=["EMA","SMA"], group=grpMa)
fastLen    = input.int(9,  "Fast MA length (the 9)",  minval=1, group=grpMa)
slowLen    = input.int(20, "Slow MA length (the 20)", minval=1, group=grpMa)
maSrc      = input.source(close, "MA source", group=grpMa)

// ── WHAT COUNTS AS RESISTANCE ────────────────────────────────────────────────
grpLevel   = "What counts as resistance"
levelSrc   = input.string("Range high", "Level the strategy trades the break of",
     options=["Range high","Pivot high"], group=grpLevel)

grpRange   = "Range detection (Range high mode)"
rangeBars  = input.int(20,    "Bars that must form the range", minval=2, group=grpRange)
maxRangeAtr= input.float(3.0, "Max range height, in ATR", step=0.1, minval=0.1, group=grpRange)
minTouches = input.int(2,     "Times the ceiling must be tested", minval=1, group=grpRange)
touchTolAtr= input.float(0.15,"How close to the ceiling counts as a touch (ATR)", step=0.05, minval=0, group=grpRange)
atrLen     = input.int(14,    "ATR length", minval=1, group=grpRange)

grpPivot   = "Pivot high (Pivot high mode)"
pivotLeft  = input.int(5, "Pivot high - left bars",  minval=1, group=grpPivot)
pivotRight = input.int(5, "Pivot high - right bars", minval=1, group=grpPivot)

grpBreak   = "Breakout"
breakBufPts= input.float(0, "Buffer above the level (points)", step=1, minval=0, group=grpBreak)
onePerLevel= input.bool(true, "Only one trade per level", group=grpBreak)
needGreen  = input.bool(true, "Breakout bar must close green", group=grpBreak)

// ── EXTENSION GATE: 150 MA ───────────────────────────────────────────────────
grpExt     = "Extension gate: 150 MA (percentile)"
useExtGate = input.bool(true, "Scale size by the stretch from the 150 MA", group=grpExt,
     tooltip="Ranks today's stretch against its own recent history, so the same settings mean the same thing on any timeframe or symbol.")
extLen     = input.int(150,   "Long MA length", minval=1, group=grpExt)
extTypeStr = input.string("SMA", "Long MA type", options=["SMA","EMA"], group=grpExt)
extLookback= input.int(500,   "Bars the percentile ranks against", minval=50, maxval=5000, group=grpExt)
extWarnRank= input.float(70,  "Warn at percentile", step=1, minval=0, maxval=100, group=grpExt)
extExtRank = input.float(90,  "No trade at percentile", step=1, minval=0, maxval=100, group=grpExt)
extWarnMult= input.float(0.5, "Size multiplier in the warn band", step=0.1, minval=0, maxval=1, group=grpExt)
extFloorPct= input.float(0.0, "Below this raw |%| always count as normal (0 = off)", step=0.05, minval=0, group=grpExt)

// ── EXTENSION GATE: DAY OPEN vs THE 9 MA ─────────────────────────────────────
grpOpen    = "Extension gate: day open vs the 9 MA"
useOpenGate= input.bool(true, "Check the stretch at the first window bar's close", group=grpOpen,
     tooltip="Price opened above the 9 MA, but by the first 5-minute close it is already stretched: size down, or stand aside for the day.")
openWarnRk = input.float(70,  "Warn at percentile", step=1, minval=0, maxval=100, group=grpOpen)
openExtRk  = input.float(90,  "No trades that day at percentile", step=1, minval=0, maxval=100, group=grpOpen)
openWarnMlt= input.float(0.5, "Size multiplier in the warn band", step=0.1, minval=0, maxval=1, group=grpOpen)

// ── TRADING WINDOW ───────────────────────────────────────────────────────────
grpSess    = "Trading window"
useSession = input.bool(true, "Restrict entries to a session window", group=grpSess)
sessWindow = input.session("0930-1130", "Window", group=grpSess)
sessTz     = input.string("America/New_York", "Timezone", group=grpSess)
closeAtEnd = input.bool(false, "Force-close when the window ends", group=grpSess)

// ── EXIT ─────────────────────────────────────────────────────────────────────
grpExit    = "Exit"
exitBufPts = input.float(0, "Close only if the bar closes this far under the 9 MA (points)", step=1, minval=0, group=grpExit)

// ── STOP ─────────────────────────────────────────────────────────────────────
grpRisk    = "Stop"
stopMode   = input.string("Range low", "Protective stop",
     options=["Range low","Swing low","ATR","Fixed points"], group=grpRisk)
swingLook  = input.int(10,   "Swing low lookback (bars)", minval=1, group=grpRisk)
stopPadPts = input.float(20, "Pad below range/swing low (points)", step=1, minval=0, group=grpRisk)
atrMult    = input.float(1.5,"ATR stop multiple", step=0.1, minval=0.1, group=grpRisk)
stopPts    = input.float(500,"Fixed stop distance (points)", step=10, minval=1, group=grpRisk)

// ── SIZING / SCALE-IN / PYRAMIDING ───────────────────────────────────────────
grpSize    = "Sizing, scale-in and pyramiding"
riskPct    = input.float(1.0, "Risk % of equity for the FULL planned position", step=0.25, minval=0.01, group=grpSize)
initialPct = input.float(50,  "% of the planned size taken on the breakout", step=5, minval=1, maxval=100, group=grpSize)
addOnGreen = input.bool(true, "Add the rest if the first bar in the trade closes green", group=grpSize)
pyramidOn  = input.bool(true, "Keep adding while the trade works", group=grpSize)
pyramidPct = input.float(50,  "% of the planned size per +1R add", step=5, minval=1, maxval=200, group=grpSize)
maxAdds    = input.int(3,     "Max +1R adds", minval=0, maxval=9, group=grpSize)
beOnAdd    = input.bool(true, "Move the stop to breakeven on the first +1R add", group=grpSize,
     tooltip="Leave this ON. Adding at +1R with the original stop still in place roughly DOUBLES open risk - see the notes at the bottom of the script.")

grpMisc    = "Housekeeping"
maxPerDay  = input.int(0, "Max entries per day (0 = unlimited)", minval=0, group=grpMisc)
showBoxes  = input.bool(true, "Draw the range that was broken", group=grpMisc)
showStats  = input.bool(true, "Show summary table", group=grpMisc)

// ═════════════════════════════════════════════════════════════════════════════
// CALCULATIONS
// ═════════════════════════════════════════════════════════════════════════════
fastMa = maTypeStr == "EMA" ? ta.ema(maSrc, fastLen) : ta.sma(maSrc, fastLen)
slowMa = maTypeStr == "EMA" ? ta.ema(maSrc, slowLen) : ta.sma(maSrc, slowLen)
extMa  = extTypeStr == "EMA" ? ta.ema(close, extLen) : ta.sma(close, extLen)

atrVal  = ta.atr(atrLen)[1]
buffer  = breakBufPts * syminfo.mintick
exitBuf = exitBufPts  * syminfo.mintick
stopPad = stopPadPts  * syminfo.mintick

// ── Range: the N bars BEHIND the current (breakout) bar ───────────────────────
rangeHigh = ta.highest(high, rangeBars)[1]
rangeLow  = ta.lowest(low,   rangeBars)[1]
rangeHgt  = rangeHigh - rangeLow
heightAtr = na(atrVal) or atrVal <= 0 ? na : rangeHgt / atrVal

touchTol  = touchTolAtr * nz(atrVal)
int touches = 0
for i = 1 to rangeBars
    if high[i] >= rangeHigh - touchTol
        touches += 1

rangeValid = not na(atrVal) and atrVal > 0 and rangeHgt > 0 and
             not na(heightAtr) and heightAtr <= maxRangeAtr and touches >= minTouches

// ── Pivot high (alternative level source) ─────────────────────────────────────
ph = ta.pivothigh(pivotLeft, pivotRight)
var float lastPh = na
if not na(ph)
    lastPh := ph

usingRange = levelSrc == "Range high"
level      = usingRange ? (rangeValid ? rangeHigh : na) : lastPh

// ── Extension percentiles ─────────────────────────────────────────────────────
// A fixed % cannot work on two timeframes at once - price sits far closer to a
// 150 MA on M5 than on D1. Ranking the stretch against its own history is
// self-calibrating, so one setting means the same thing everywhere.
extPct   = extMa != 0 ? 100.0 * (close - extMa) / extMa : na
extRank  = ta.percentrank(math.abs(nz(extPct)), extLookback)
ma9Pct   = fastMa != 0 ? 100.0 * (close - fastMa) / fastMa : na
ma9Rank  = ta.percentrank(math.abs(nz(ma9Pct)), extLookback)

f_rankMult(rank, pct, warnR, extR, warnM, floorPct) =>
    float m = 1.0
    if not na(rank) and not na(pct)
        if floorPct > 0 and math.abs(pct) < floorPct
            m := 1.0
        else if rank >= extR
            m := 0.0
        else if rank >= warnR
            m := warnM
    m

// Only a stretch ABOVE the long MA argues against a fresh long.
extMult = not useExtGate or na(extPct) or extPct <= 0 ? 1.0
           : f_rankMult(extRank, extPct, extWarnRank, extExtRank, extWarnMult, extFloorPct)

// ── Session window ────────────────────────────────────────────────────────────
inSession = not useSession or not na(time(timeframe.period, sessWindow, sessTz))
firstSessionBar = useSession and inSession and not inSession[1]

// ── Per-day bookkeeping ───────────────────────────────────────────────────────
newDay = ta.change(time("D")) != 0
var int   tradesToday   = 0
var float lastUsedLevel = na
var float dayOpenMult   = 1.0
if newDay
    tradesToday   := 0
    lastUsedLevel := na
    dayOpenMult   := 1.0

// "Price opened above the 9 MA, but by the first 5-minute close it is already
// too far" - evaluated once a day, at the first window bar's close.
if firstSessionBar
    dayOpenMult := useOpenGate and close > fastMa
                     ? f_rankMult(ma9Rank, ma9Pct, openWarnRk, openExtRk, openWarnMlt, extFloorPct)
                     : 1.0

sizeMult = math.min(extMult, dayOpenMult)

sameLevelTol = math.max(syminfo.mintick, 0.25 * nz(atrVal))
levelBlocked = onePerLevel and not na(lastUsedLevel) and not na(level) and
               math.abs(level - lastUsedLevel) < sameLevelTol

// ── Signal ────────────────────────────────────────────────────────────────────
maFilter   = fastMa > slowMa
greenBreak = not needGreen or close > open
flat       = strategy.position_size == 0

breakout = usingRange
             ? (rangeValid and close > level + buffer)
             : (not na(lastPh) and ta.crossover(close, lastPh + buffer))

dayCapOk = maxPerDay == 0 or tradesToday < maxPerDay

longSignal = flat and inSession and maFilter and greenBreak and breakout and dayCapOk and
             not levelBlocked and not na(level) and sizeMult > 0 and barstate.isconfirmed

// ── Stop price for this signal ────────────────────────────────────────────────
swingLow = ta.lowest(low, swingLook)
float stopPx = na
if stopMode == "Range low"
    stopPx := (usingRange and rangeValid ? rangeLow : swingLow) - stopPad
else if stopMode == "Swing low"
    stopPx := swingLow - stopPad
else if stopMode == "ATR"
    stopPx := close - atrMult * nz(atrVal)
else if stopMode == "Fixed points"
    stopPx := close - stopPts * syminfo.mintick

// ═════════════════════════════════════════════════════════════════════════════
// ORDERS
// ═════════════════════════════════════════════════════════════════════════════
var float plannedQty = na
var float entryPx    = na
var float riskDist   = na
var float initStop   = na
var float activeStop = na
var int   entryBar   = na
var bool  secondDone = false
var int   addsDone   = 0

inPos = strategy.position_size > 0

// ── 1. Exit first: the bar closes under the 9 MA. Not restricted to the window.
if inPos and close < fastMa - exitBuf
    strategy.close_all(comment="close<9MA")

if inPos and closeAtEnd and not inSession
    strategy.close_all(comment="window end")

// ── 2. Entry: first slice ─────────────────────────────────────────────────────
if longSignal and not na(stopPx) and stopPx < close
    // Risk %, sized against the stop, then cut by the extension gates.
    planned = (strategy.equity * riskPct / 100.0) / (close - stopPx) * sizeMult
    first   = planned * initialPct / 100.0
    if first > 0
        strategy.entry("L0", strategy.long, qty=first)
        plannedQty := planned
        initStop   := stopPx
        activeStop := stopPx
        entryBar   := bar_index
        secondDone := initialPct >= 100 or not addOnGreen
        addsDone   := 0
        entryPx    := na
        riskDist   := na
        tradesToday   += 1
        lastUsedLevel := level

        if showBoxes and usingRange and rangeValid
            box.new(left=bar_index - rangeBars, top=rangeHigh, right=bar_index, bottom=rangeLow,
                     border_color=color.new(color.orange, 20), border_width=1,
                     bgcolor=color.new(color.orange, 88))

// ── 3. Once filled, learn the real entry price and one R ──────────────────────
if inPos and na(entryPx) and strategy.opentrades > 0
    entryPx  := strategy.opentrades.entry_price(0)
    riskDist := entryPx - nz(initStop, entryPx)

// ── 4. The other half, if the FIRST bar in the trade closed green ─────────────
// The breakout bar is the green candle we entered on; this is the next one.
if inPos and not secondDone and addOnGreen and not na(entryBar) and bar_index == entryBar + 1
    secondDone := true
    if close > open
        rest = plannedQty - strategy.position_size
        if rest > 0
            strategy.entry("L1", strategy.long, qty=rest)
else if inPos and not secondDone and not na(entryBar) and bar_index > entryBar + 1
    secondDone := true      // the chance has passed; never add late

// ── 5. +1R adds while the trade keeps working ─────────────────────────────────
if inPos and pyramidOn and addsDone < maxAdds and not na(riskDist) and riskDist > 0
    if close >= entryPx + (addsDone + 1) * riskDist
        slice = plannedQty * pyramidPct / 100.0
        if slice > 0
            addsDone += 1
            strategy.entry("P" + str.tostring(addsDone), strategy.long, qty=slice)
            if beOnAdd
                activeStop := entryPx

// ── 6. Protective stop, re-issued for every open entry ────────────────────────
if (longSignal or inPos) and not na(activeStop)
    strategy.exit("Stop", stop=activeStop)

// ── 7. Reset when flat ────────────────────────────────────────────────────────
if strategy.position_size == 0 and not longSignal
    plannedQty := na
    entryPx    := na
    riskDist   := na
    initStop   := na
    activeStop := na
    entryBar   := na
    secondDone := false
    addsDone   := 0

// ═════════════════════════════════════════════════════════════════════════════
// VISUALS
// ═════════════════════════════════════════════════════════════════════════════
plot(fastMa, "Fast MA", color=color.new(color.aqua,   0), linewidth=2)
plot(slowMa, "Slow MA", color=color.new(color.orange, 0), linewidth=2)
plot(extMa,  "Long MA", color=color.new(color.fuchsia,0), linewidth=1)
bgcolor(useSession and inSession ? (sizeMult <= 0 ? color.new(color.red, 90)
     : sizeMult < 1 ? color.new(color.yellow, 92) : color.new(color.blue, 93)) : na, title="Session window")

plot(usingRange and rangeValid ? rangeHigh : na, "Valid range ceiling",
     color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=1)
plot(usingRange and rangeValid ? rangeLow : na, "Valid range floor",
     color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(inPos ? activeStop : na, "Active stop",
     color=color.new(color.fuchsia, 0), style=plot.style_linebr, linewidth=1)

plot(heightAtr, "Range height (ATR)", display=display.data_window)
plot(touches,   "Ceiling touches",    display=display.data_window)
plot(extRank,   "150 MA ext percentile", display=display.data_window)
plot(extPct,    "150 MA ext %",       display=display.data_window)
plot(ma9Rank,   "9 MA ext percentile", display=display.data_window)
plot(sizeMult,  "Size multiplier",    display=display.data_window)
plot(plannedQty,"Planned qty",        display=display.data_window)

if showStats and barstate.islastconfirmedhistory
    closed  = strategy.closedtrades
    wins    = strategy.wintrades
    winRate = closed > 0 ? 100.0 * wins / closed : na
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    avgWin  = wins > 0 ? strategy.grossprofit / wins : na
    avgLoss = (closed - wins) > 0 ? strategy.grossloss / (closed - wins) : na
    rr      = not na(avgWin) and not na(avgLoss) and avgLoss > 0 ? avgWin / avgLoss : na

    var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 10),
                             frame_color=color.new(color.gray, 50), frame_width=1)
    table.cell(t, 0, 0, "Backtest", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 40))
    table.cell(t, 1, 0, usingRange ? "range" : "pivot", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 40))
    table.cell(t, 0, 1, "Trades", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(closed), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "Win rate", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 2, na(winRate) ? "-" : str.tostring(winRate, "0.0") + "%",
               text_color=na(winRate) ? color.gray : winRate >= 50 ? color.lime : color.orange, text_size=size.small)
    table.cell(t, 0, 3, "Profit factor", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 3, na(pf) ? "-" : str.tostring(pf, "0.00"),
               text_color=na(pf) ? color.gray : pf >= 1 ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 4, "Avg win / avg loss", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 4, na(rr) ? "-" : str.tostring(rr, "0.00"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 5, "Net profit", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(strategy.netprofit, "0.00"),
               text_color=strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.small)

// =============================================================================
// NOTES
//
// 1. PYRAMIDING DOUBLES YOUR RISK IF YOU TURN OFF BREAKEVEN-ON-ADD.
//    Full position P, stop distance D, so P*D = 1R of risk.
//    At +1R you add 0.5P. That slice is now 2D away from the original stop,
//    so it carries 0.5P * 2D = 1R of risk on its own. Total open risk = 2R,
//    on a trade that was already working. "Move the stop to breakeven on the
//    first +1R add" caps it near 0.5R instead. Leave it on unless you have a
//    specific reason not to, and check the drawdown either way.
//
// 2. Set costs. Commission and slippage default to 0, which is not a market.
//    Put your typical gold spread into Slippage (ticks) under Properties.
//
// 3. Win rate alone says nothing here. The exit is "close under the 9 MA", so
//    winners run and losers are cut at a fixed stop. Read Profit Factor and
//    Avg win / Avg loss beside it.
//
// 4. Scaling in makes win rate harder to read, not easier. A trade that gets
//    the green add and three +1R adds is a different bet from one that gets
//    half size and stops out. Compare Net Profit and Max Drawdown across
//    settings, not win rate.
//
// 5. Sample size. A two-hour window plus two extension gates cuts the trade
//    count hard. Under ~50 closed trades you are reading noise. Check the
//    trade count before concluding a gate "helped".
//
// 6. Orders fill at the NEXT bar's open, matching the EA. Do not switch on
//    process_orders_on_close - it fills at the signal bar's close, which you
//    could not have got.
//
// 7. No repainting: every signal input is a closed-bar value and there are no
//    higher-timeframe requests.
//
// 8. Verify in the List of Trades that a stop-out closes the WHOLE position,
//    adds included. The stop is issued with no from_entry, which Pine applies
//    to every open entry - worth confirming on your build before going live.
// =============================================================================
